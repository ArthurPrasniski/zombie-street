# Copie para .env.local (fica fora do git). Variáveis EXPO_PUBLIC_* vão para dentro do app;
# as outras só servem para gerar o build nativo (app.config.ts). Ver docs/BACKEND.md.

# Servidor (no simulador iOS, http://localhost:3000 funciona; no celular, o IP do Mac na rede)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Sign-In: o Web client ID (é o público do token que o servidor confere) e o iOS client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# O iOS client ID ao contrário (com.googleusercontent.apps.XXXX), para o build nativo
GOOGLE_IOS_URL_SCHEME=

# RevenueCat: chaves públicas do SDK (Project settings > API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob: IDs do aplicativo (build nativo) e do bloco de anúncio premiado (no app).
# Vazios = IDs de teste do Google.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
