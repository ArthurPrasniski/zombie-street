# Cole na aba Environment da API PRD no Dokploy; não reutilize os segredos de DEV.
NODE_ENV=production
PORT=3000
# Internal Connection URL do novo banco PRD (inclui usuário, senha, host interno e banco).
DATABASE_URL=
# Gere três valores diferentes com openssl rand -hex 32.
JWT_SECRET=
REVENUECAT_WEBHOOK_AUTH=
ADMIN_TOKEN=
# Mesmo valor do EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID usado no app.
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=com.arthurprasniski.estradazumbi
DEV_ROUTES=0
PUSH_WORKER=1
PUSH_INTERVAL_MS=15000
# Opcional: apenas se a segurança reforçada de push estiver habilitada no Expo.
EXPO_ACCESS_TOKEN=

# Discord: configure apenas na API PRD. URL criada em Canal > Integrações > Webhooks.
DISCORD_WEBHOOK_URL=
DISCORD_WORKER=1

# Gem ads: Android/iOS rewarded unit IDs, comma separated (ca-app-pub-.../...).
# AdMob SSV callback: https://YOUR_PUBLIC_API/webhooks/admob
# Empty keeps gem ads unavailable until the integration is configured.
ADMOB_REWARDED_UNIT_IDS=
