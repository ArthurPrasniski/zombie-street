# Copie para .env.local (não vai para o git) ou configure no serviço de hospedagem.
PORT=3000
# Postgres de produção. Sem ele, o servidor usa o PGlite (Postgres embutido) na pasta DATA_DIR.
# DATABASE_URL=postgres://usuario:senha@host:5432/zombieroad
DATA_DIR=.data/pglite
# Segredo da sessão: 32+ caracteres aleatórios (ex.: openssl rand -hex 32). Obrigatório em produção.
JWT_SECRET=
# Google: o "Web client ID" (é o público do idToken que o app recebe). Vários separados por vírgula.
GOOGLE_CLIENT_IDS=
# Apple: o bundle identifier do app no iOS.
APPLE_AUDIENCES=
# RevenueCat > Integrations > Webhooks > Authorization header (o valor inteiro, ex.: "Bearer abc...").
REVENUECAT_WEBHOOK_AUTH=
# Em desenvolvimento: 1 liga o login "dev:nome" e a compra simulada (sempre desligado em produção).
DEV_ROUTES=1
