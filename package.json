{
  "name": "zombie-road",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm run start -w @zombie-road/mobile --",
    "ios": "npm run ios -w @zombie-road/mobile --",
    "android": "npm run android -w @zombie-road/mobile --",
    "server": "npm run dev -w @zombie-road/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @zombie-road/mobile",
    "art": "npm run art -w @zombie-road/mobile --",
    "art:brand": "npm run art:brand -w @zombie-road/mobile --",
    "sfx": "npm run sfx -w @zombie-road/mobile --"
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true
  }
}
